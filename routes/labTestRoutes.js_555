const express = require('express');
const LabTestController = require('../controllers/labTestController');
const jwtAuth = require('../middleware/jwtAuth'); // Middleware to check JWT
const validateSchema = require('../middleware/validateSchema');
const { addToCartSchema } = require('../validation/cartValidator');
const { uploadPrescriptionSchema } = require('../validation/prescriptionValidator');
const { labOrderValidation } = require('../validation/labOrderValidation');
const router = express.Router();

router.get('/packages-and-tests', jwtAuth, LabTestController.getPackagesAndTests);
router.post('/upload',jwtAuth, validateSchema(uploadPrescriptionSchema), LabTestController.uploadPrescription);
router.post('/addToCart',jwtAuth, validateSchema(addToCartSchema), LabTestController.addToCart);
router.get('/cities', jwtAuth, LabTestController.getAllActiveCities);
router.post('/cart/details',jwtAuth, LabTestController.getCartDetailsByPatientId);
router.post('/cart/lab-details', jwtAuth, LabTestController.getLabDetailsByCart);
router.post('/branches',jwtAuth, LabTestController.getBranchesByLabAndCity);
router.post('/tests-and-packages', jwtAuth, LabTestController.getTestsAndPackagesByLab);
router.post('/test-or-package-details', jwtAuth, LabTestController.getTestOrPackageDetails);
router.delete('/remove/:cartId', jwtAuth, LabTestController.removeCartItem);
router.get('/prescription/:patientId', jwtAuth, LabTestController.getPrescriptionUrl);
router.delete('/prescription/:prescriptionId', jwtAuth, LabTestController.deletePrescription);
router.post('/order',jwtAuth, LabTestController.createLabOrder);
router.get('/orders/:orderId', jwtAuth, LabTestController.getLabOrdersByPatient);
router.put('/order', LabTestController.updateLabOrder);
router.get('/list/:patientId', LabTestController.getLabOrders);
router.delete('/cartRemove/:cartId', jwtAuth, LabTestController.removeCart);
router.put('/cart', jwtAuth, LabTestController.updateLabId);
router.get('/labDetail/:cartId', jwtAuth, LabTestController.getLabDetail);
router.post('/purchaseLabTest', jwtAuth, LabTestController.purchaseLabTest);
router.post('/purchaseLabTestMobile', jwtAuth, LabTestController.purchaseLabTestMobile);

router.post('/paymentStatus', jwtAuth, LabTestController.paymentStatus);
router.post('/paymentStatusMobile', LabTestController.paymentStatusMobile);

router.put('/updateAddress', jwtAuth, LabTestController.updateAddress);
router.get('/getLabTestAddress', jwtAuth, LabTestController.getLabTestAddress);


module.exports = router;
